DB_NAME=turbotubo
DB_USER=turbotubo
DB_PASSWORD=turbotubo
DB_HOST=localhost
DB_PORT=5432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes any previously-encrypted PBX passwords unreadable.
PBX_ENCRYPTION_KEY=

CELERY_BROKER_URL=redis://localhost:6379/0

# --- Seguridad (turbotubo/settings.py) ---
# DEBUG=True SOLO en desarrollo local. En producción no se define (o se define en False):
# si falta en producción, Django ahora falla al arrancar en vez de correr insegura por error.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En producción es obligatorio (el deploy falla si falta y DEBUG=False). Generar con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
