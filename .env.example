DB_NAME=turbotubo
DB_USER=turbotubo
DB_PASSWORD=turbotubo
DB_HOST=localhost
DB_PORT=5432

# --- Migracion de datos (solo lectura, opcional) ---
# Conexion a la base vieja de turbotubobeta en Azure, usada unicamente por
# `manage.py inspeccionar_legacy`. Dejar vacio salvo cuando se este haciendo el ensayo de
# migracion. Usar la credencial YA ROTADA (nunca la que quedo expuesta en el historial de git).
# LEGACY_DB_HOST=turbotubobeta-server.postgres.database.azure.com
# LEGACY_DB_NAME=turbotubobeta-database
# LEGACY_DB_USER=
# LEGACY_DB_PASSWORD=
# LEGACY_DB_PORT=5432

# --- Metadata anonimizada para ML (mlmetadata) ---
# Contenedor Blob separado de "media" para los exports (manage.py shell -> tasks.exportar_metadata_ml).
# Usa las mismas AZURE_STORAGE_ACCOUNT/_KEY/_CONNECTION_STRING que ya existen para media; sin
# ellas, cae a ./ml_exports/ en local. Ver mlmetadata/storage.py.
# AZURE_ML_CONTAINER=ml-training-data

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes any previously-encrypted PBX passwords unreadable.
PBX_ENCRYPTION_KEY=

CELERY_BROKER_URL=redis://localhost:6379/0

# --- Seguridad (turbotubo/settings.py) ---
# DEBUG=True SOLO en desarrollo local. En producción no se define (o se define en False):
# si falta en producción, Django ahora falla al arrancar en vez de correr insegura por error.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En producción es obligatorio (el deploy falla si falta y DEBUG=False). Generar con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
